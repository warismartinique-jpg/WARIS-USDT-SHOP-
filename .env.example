# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional comma-separated list of additional admin emails (in addition to primary owner)
ADMIN_EMAILS=

# PayGate Global (Togo : T-Money / Mixx by Yas & Moov Money / Flooz) - Server-side only
PAYGATE_AUTH_TOKEN=
PAYGATE_WEBHOOK_SECRET=

# Optional Notifications (Email & WhatsApp Business API)
RESEND_API_KEY=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
